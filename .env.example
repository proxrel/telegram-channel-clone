# Your Telegram API credentials.
# See README.md > "How to Get a Telegram API ID and API Hash" for how to get these.
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Name of the session file Telethon will create (no extension).
# On first run you'll log in with your phone number + code, after which a
# .session file with this name is created and you won't be asked to log in again.
SESSION_NAME=channel_forwarder

# Source and destination group/channel.
# You can use @username or a numeric ID (starting with -100...).
# To find the numeric ID: python list_ids.py
SOURCE_CHANNEL=@source_channel_or_id
DEST_CHANNEL=@destination_channel_or_id

# When true, NOTHING is sent to the destination group -
# it only prints to the console what would happen. Test with true first,
# and once everything looks right, set it to false to start the real transfer.
DRY_RUN=true

# When true, messages sent to the destination group don't trigger notifications (silent).
SILENT_FORWARD=false

# Delay between messages, in seconds. Don't lower it too much to avoid
# hitting Telegram's flood limits; increase it if needed.
POST_DELAY_SECONDS=0.8

# Progress/log file. Keeps track of which messages have been sent so the
# script can resume where it left off if interrupted.
RESUME_FILE=state.json

# File that stores the topic name -> destination topic ID mapping.
TOPIC_MAP_FILE=topic_map.json
