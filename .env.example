API_ID=123456
API_HASH=your_api_hash
SESSION_NAME=channel_forwarder
SOURCE_CHANNEL=@kaynakkanal
DEST_CHANNEL=@yenikanal
DRY_RUN=true
SILENT_FORWARD=false
POST_DELAY_SECONDS=0.8
BATCH_SIZE=100
RESUME_FILE=state.json

# Bölüm mantığı
# hashtags: mesaj içindeki ilk hashtag'i aktif bölüm sayar. Örn: #pediatri
# regex: SECTION_REGEX ile başlık yakalar. Örn: ## Yenidoğan
SECTION_MODE=hashtags
SECTION_REGEX=^(?:#|##)\s*(.+)$

# Hedef forum/topic yapısı kullanacaksan true yap.
TOPIC_MODE=false
TOPIC_MAP_FILE=topic_map.json
