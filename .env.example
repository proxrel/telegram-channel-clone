# Telegram API kimlik bilgileriniz.
# Nasıl alınacağı için README.md > "Telegram API ID ve API Hash Nasıl Alınır?" bölümüne bakın.
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Telethon'un oluşturacağı oturum dosyasının adı (uzantısız).
# İlk çalıştırmada telefon numaranız + kodla giriş yaparsınız,
# ardından bu isimde bir .session dosyası oluşur ve bir daha giriş istemez.
SESSION_NAME=channel_forwarder

# Kaynak ve hedef grup/kanal.
# @kullaniciadi ya da sayısal ID (-100... ile başlar) kullanabilirsiniz.
# Sayısal ID'yi bulmak için: python list_ids.py
SOURCE_CHANNEL=@kaynak_kanal_veya_id
DEST_CHANNEL=@hedef_kanal_veya_id

# true iken hedef gruba hiçbir mesaj veya medya GÖNDERİLMEZ,
# sadece konsola ne yapılacağı yazdırılır. Önce true ile test edin,
# her şey doğruysa false yapıp gerçek aktarımı başlatın.
DRY_RUN=true

# true olursa hedef gruba giden mesajlar bildirim göndermeden (sessiz) gider.
SILENT_FORWARD=false

# Mesajlar arasında beklenecek süre (saniye). Telegram flood limitlerine
# takılmamak için düşürmeyin; gerekirse artırın.
POST_DELAY_SECONDS=0.8

# İlerleme/log dosyası. Script kesintiye uğrarsa kaldığı yerden devam
# edebilmesi için burada hangi mesajların gönderildiği tutulur.
RESUME_FILE=state.json

# Konu başlığı (topic) adı -> hedefteki topic ID eşleşmesinin tutulduğu dosya.
TOPIC_MAP_FILE=topic_map.json
